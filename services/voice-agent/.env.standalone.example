# ============================================================
# TeamFlow — Standalone Voice .env
# No external APIs needed — 100% self-hosted
# ============================================================

# Database
DATABASE_URL=postgresql://teamflow_user:teamflow_pass_2026@postgres:5432/teamflow

# ── WebRTC Gateway (self-hosted, replaces Asterisk) ──────────
WEBRTC_GATEWAY_URL=http://webrtc-gateway:3004
# Public IP for WebRTC穿透 (STUN/TURN fallback)
WEBRTC_ANNOUNCED_IP=your.public.ip.here

# ── Voice AI (all self-hosted) ──────────────────────────────
WHISPER_URL=http://whisper:9000
WHISPER_MODEL=base

PIPER_URL=http://piper:5000
PIPER_VOICE=en_US-amy-medium

# ── LLM (choose one or chain) ────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# Or OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or MiniMax (optional)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01

# ── Optional: Asterisk fallback for PSTN/SIP trunking ──────
# Only needed if you want real phone number calling
# ASTERISK_HOST=
# ASTERISK_PORT=5038
# ASTERISK_USER=teamflow
# ASTERISK_SECRET=your_secret