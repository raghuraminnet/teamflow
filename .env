# ============================================================
# TeamFlow — Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# ------------------------------------------------------------
# SECURITY (Required)
# ------------------------------------------------------------
JWT_SECRET=teamflow-dev-jwt-secret-key-change-in-production-32chars
JWT_REFRESH_SECRET=teamflow-dev-refresh-secret-key-change-prod-32chars

# ------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------
FRONTEND_ORIGIN=https://teamflow.codeapp.site

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT=100           # requests per minute per user
RATE_LIMIT_IP=500        # requests per minute per IP

# ------------------------------------------------------------
# VOICE AGENT (Asterisk)
# ------------------------------------------------------------
# Set ASTERISK_HOST to your Asterisk server IP/hostname
# For local development, use localhost
ASTERISK_HOST=asterisk
ASTERISK_PORT=5038
ASTERISK_MANAGER_USER=teamflow
ASTERISK_MANAGER_SECRET=your-asterisk-manager-secret
ASTERISK_CONTEXT=teamflow-inbound

# ------------------------------------------------------------
# SPEECH (STT / TTS)
# ------------------------------------------------------------
# Whisper STT — set URL to your Whisper service
# Leave as http://whisper:9001 if running in Docker
WHISPER_URL=http://whisper:9001
WHISPER_MODEL=base

# Piper TTS — set URL to your Piper TTS service
PIPER_URL=http://piper:5000
PIPER_VOICE=en_US-amy-medium

# ------------------------------------------------------------
# LLM (AI Brain for Voice Agents)
# ------------------------------------------------------------
# Provider: ollama (self-hosted) or openai
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ------------------------------------------------------------
# EMAIL (Notifications)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ------------------------------------------------------------
# SSL (Optional — for HTTPS)
# ------------------------------------------------------------
# Place certificates at nginx/ssl/
# SSL_CERT=/etc/nginx/ssl/fullchain.pem
# SSL_KEY=/etc/nginx/ssl/privkey.pem
WEBRTC_ANNOUNCED_IP=45.32.104.152
